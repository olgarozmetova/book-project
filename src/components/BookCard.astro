---
import type { CollectionEntry } from 'astro:content'

interface Props {
    book: CollectionEntry<'books'>
}

const { book } = Astro.props
---


<div class="bg-purple-50 py-4 px-5 my-5 mx-auto shadow-hard shadow-violet-100">
    <p class="text-2xl font-bold">{book.data.title}, {book.data.rating}/10</p>
    <p>{book.data.author}</p>
    <p class="text-base">{book.data.summary}</p>
    <a href=''>Read Review</a>
</div>